rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function text(s, maximum) { return s is string && s.size() > 0 && s.size() <= maximum && s.matches('.*[^ ].*'); }
  function date(s) { return s is string && s.matches('(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
  function money(n) { return n is int && n >= 0 && n <= 1000000000; }
  function validTripPin(d) {
   return !d.keys().hasAny(['destinationLatitude','destinationLongitude']) ||
    (d.keys().hasAll(['destinationLatitude','destinationLongitude']) &&
     ((d.destinationLatitude == null && d.destinationLongitude == null) ||
      (d.destinationLatitude is number && d.destinationLongitude is number &&
       d.destinationLatitude >= -90 && d.destinationLatitude <= 90 &&
       d.destinationLongitude >= -180 && d.destinationLongitude <= 180)));
  }
  function validTrip(d) {
   return d.keys().hasAll(['title','destination','startDate','endDate','budgetSatang','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','destination','startDate','endDate','budgetSatang','status','createdAt','updatedAt','destinationLatitude','destinationLongitude','completed'])
    && d.get('completed', false) is bool
    && validTripPin(d)
    && text(d.title,100) && text(d.destination,100) && date(d.startDate) && date(d.endDate)
    && (d.startDate < d.endDate || (d.status == 'deleting' && d.startDate == d.endDate)) && money(d.budgetSatang) && d.status in ['active','deleting']
    && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  match /users/{uid}/trips/{tripId} {
   allow read: if owner(uid);
   allow create: if owner(uid) && validTrip(request.resource.data) && request.resource.data.status == 'active' && request.resource.data.get('completed', false) == false && request.resource.data.createdAt == request.time;
   allow update: if owner(uid) && validTrip(request.resource.data)
    && request.resource.data.createdAt == resource.data.createdAt && resource.data.status == 'active'
    && (!resource.data.get('completed', false) || request.resource.data.get('completed', false))
    && (request.resource.data.status == 'active' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
   allow delete: if owner(uid) && resource.data.status == 'deleting';
   match /activities/{activityId} {
    function parent() {return get(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));}
    function parentAfter() {return getAfter(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));}
    function validExtension(d) {
      return (!d.keys().hasAny(['schemaVersion','category','orderIndex','costKnown','travelMode','travelFromId','travelSignature','travelCostSatang','travelCostKnown'])) || (
        d.keys().hasAll(['schemaVersion','category','orderIndex','costKnown','travelMode','travelFromId','travelSignature','travelCostSatang','travelCostKnown']) && d.schemaVersion == 2
        && d.category in ['attraction','food','lodging','other']
        && d.orderIndex is int && d.orderIndex >= 0 && d.orderIndex <= 1000000000
        && d.costKnown is bool && (d.costKnown || d.estimatedCostSatang == 0)
        && d.travelMode in ['none','car','motorcycle','walk','transit']
        && d.travelFromId is string && d.travelFromId.size() <= 128
        && d.travelSignature is string && d.travelSignature.size() <= 1024
        && d.travelCostKnown is bool && money(d.travelCostSatang)
        && (d.travelCostKnown || d.travelCostSatang == 0)
        && (d.travelMode != 'none' || (!d.travelCostKnown && d.travelCostSatang == 0 && d.travelFromId == '' && d.travelSignature == ''))
      );
    }
    function validActivity(d) {
     return d.keys().hasAll(['title','date','timeMinutes','estimatedCostSatang','latitude','longitude','note','createdAt','updatedAt'])
      && d.keys().hasOnly(['title','date','timeMinutes','estimatedCostSatang','latitude','longitude','note','createdAt','updatedAt','schemaVersion','category','orderIndex','costKnown','travelMode','travelFromId','travelSignature','travelCostSatang','travelCostKnown'])
      && validExtension(d)
      && text(d.title,100) && date(d.date) && d.date >= parentAfter().data.startDate && d.date <= parentAfter().data.endDate
      && d.timeMinutes is int && d.timeMinutes >= 0 && d.timeMinutes < 1440
      && money(d.estimatedCostSatang) && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
      && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
      && d.note is string && d.note.size() <= 500 && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    allow read: if owner(uid) && exists(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));
    allow create: if owner(uid) && parentAfter().data.status == 'active' && validActivity(request.resource.data) && request.resource.data.createdAt == request.time;
    allow update: if owner(uid) && parentAfter().data.status == 'active' && validActivity(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    allow delete: if owner(uid) && parent().data.status in ['active','deleting'];
   }
   // Packing checklist: one document holding the whole list. Each entry is
   // validated by the app; the rules bound the shape and size.
   match /packing/{docId} {
    function tripDoc() {return get(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));}
    function tripAfter() {return getAfter(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));}
    function validPacking(d) {
     return docId == 'checklist'
      && d.keys().hasAll(['items','updatedAt']) && d.keys().hasOnly(['items','updatedAt'])
      && d.items is list && d.items.size() <= 200 && d.updatedAt == request.time;
    }
    allow read: if owner(uid) && exists(/databases/$(database)/documents/users/$(uid)/trips/$(tripId));
    allow create, update: if owner(uid) && tripAfter().data.status == 'active' && validPacking(request.resource.data);
    allow delete: if owner(uid) && tripDoc().data.status in ['active','deleting'];
   }
  }
 }
}
